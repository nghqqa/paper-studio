# Single-origin Caddyfile for docker-compose.proxy.yml
# Routes `/ds/*` to the ONLYOFFICE container and everything else to Paper Studio.
{$SITE_ADDRESS::80} {
    encode gzip zstd

    handle_path /ds/* {
        reverse_proxy onlyoffice:80 {
            header_up X-Forwarded-Host {host}/ds
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle {
        reverse_proxy app:8000
    }
}
