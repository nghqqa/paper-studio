# =============================================================================
# Paper Studio (研稿) — Environment Configuration
# Copy to `.env` and replace placeholder secrets before starting.
# =============================================================================

# --- Core ---
PAPER_PORT=8000
# Pre-built image (default pulls from GHCR; run `docker compose build` to build locally)
PAPER_STUDIO_IMAGE=ghcr.io/nghqqa/paper-studio:latest

# REQUIRED: Session signing secret (>=32 random chars, e.g. `openssl rand -hex 32`)
PAPER_STUDIO_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Authentication (`on` recommended; first registered account becomes superuser)
PAPER_STUDIO_AUTH=on
# Set to `on` when serving over HTTPS behind a reverse proxy
PAPER_STUDIO_COOKIE_SECURE=off

# Auto-verify uploaded templates (LaTeX compile / ONLYOFFICE convert) & generate cover thumbnails
PAPER_STUDIO_TEMPLATE_AUTO_ACCEPT=on

# --- Resource & Concurrency Limits ---
BACKEND_MEM=2g
BACKEND_CPUS=2
PAPER_STUDIO_LATEX_CONCURRENCY=1
PAPER_STUDIO_DOCX_EXPORT_CONCURRENCY=1
PAPER_STUDIO_LATEX_RLIMIT_AS_GB=2
PAPER_STUDIO_ARTIFACT_KEEP=20

# --- Native Word Editing (Optional: enable with `docker compose --profile word up -d`) ---
# Uncomment the line below to always start ONLYOFFICE with `docker compose up -d`
# COMPOSE_PROFILES=word
PAPER_STUDIO_WORD_EDITOR=on

# REQUIRED for Word mode: independent random JWT secret (`openssl rand -hex 32`)
ONLYOFFICE_JWT_SECRET=change-me-to-another-random-jwt-secret

# Browser-reachable URLs (replace 127.0.0.1 with your LAN IP or HTTPS domain in production)
PAPER_STUDIO_PUBLIC_ORIGIN=http://127.0.0.1:8000
PAPER_STUDIO_ONLYOFFICE_URL=http://127.0.0.1:9980
# Internal URL used by ONLYOFFICE container to fetch/callback Paper Studio
PAPER_STUDIO_ONLYOFFICE_PUBLIC_URL=http://app:8000

ONLYOFFICE_PORT=9980
ONLYOFFICE_IMAGE_TAG=10.0.0
ONLYOFFICE_MEM=4g
ONLYOFFICE_CPUS=2
ONLYOFFICE_FONTS_DIR=./fonts

# --- Optional: Build Acceleration Mirrors (useful in China mainland) ---
# APT_MIRROR=mirrors.cloud.tencent.com
# PYPI_MIRROR=https://mirrors.cloud.tencent.com/pypi/simple
# NPM_MIRROR=https://registry.npmmirror.com
